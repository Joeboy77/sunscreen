// Hello World in Sunscreen Language
print "Hello, World!";

// Basic arithmetic
let x = 10;
let y = 5;
print x + y;
print x * y;

// Variables and strings
let name = "Sunscreen";
print "Welcome to " + name + " Language!";

// Boolean values
let is_awesome = true;
print is_awesome;

// Simple function
fn greet(name) {
    print "Hello, " + name + "!";
}

greet("Developer");

// Conditional statements
let age = 25;
if (age >= 18) {
    print "You are an adult!";
} else {
    print "You are a minor!";
}

// Loops
let i = 1;
while (i <= 3) {
    print "Count: " + i;
    i = i + 1;
} 